<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.lumbridgecorp.lumbridge-voice-learn</string>
 <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/.local/bin/lumbridge-voice</string><string>learn</string></array>
 <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>40</integer></dict>
 <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Lumbridge Voice/learn.log</string>
 <key>StandardOutPath</key><string>__HOME__/Library/Logs/Lumbridge Voice/learn.log</string>
</dict></plist>
