<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <!-- build.sh sets the bundle id (LUMBRIDGE_VOICE_BUNDLE_ID). macOS ties the microphone, accessibility
      and screen recording grants to it. -->
 <key>CFBundleIdentifier</key><string>com.lumbridgecorp.lumbridge-voice.app</string>
 <key>CFBundleName</key><string>Lumbridge Voice</string>
 <key>CFBundleDisplayName</key><string>Lumbridge Voice</string>
 <key>CFBundleExecutable</key><string>LumbridgeVoice</string>
 <key>CFBundlePackageType</key><string>APPL</string>
 <key>CFBundleShortVersionString</key><string>1.1</string>
 <key>CFBundleVersion</key><string>2</string>
 <key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/></dict>
 <key>LSUIElement</key><true/>
 <key>LSMinimumSystemVersion</key><string>14.0</string>
 <key>NSSpeechRecognitionUsageDescription</key><string>Backup dictation on this Mac when the speech server is unreachable.</string>
 <key>NSMicrophoneUsageDescription</key><string>Lumbridge Voice: hold or tap right Option to dictate; audio is transcribed by the speech server you set.</string>
</dict></plist>
